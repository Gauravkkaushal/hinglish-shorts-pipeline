# Copy this file to .env and fill it in. Never share/commit .env.

# Free LLM (writes scripts + acts as "Director"). Key: https://console.groq.com
GROQ_API_KEY=

# Optional: any OpenAI-compatible provider instead of Groq (example: Gemini)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash   (Groq default: openai/gpt-oss-120b)
# LLM_API_KEY=

# AI voice: hi-IN-MadhurNeural (male) or hi-IN-SwaraNeural (female)
TTS_VOICE=hi-IN-MadhurNeural
TTS_RATE=+8%

# Transcription for podcast clips: large-v3-turbo = best Hindi, small = faster
WHISPER_MODEL=large-v3-turbo
WHISPER_LANG=hi

# Instagram upload (README: Upload): token of the Facebook Page linked to your professional Instagram account
# IG_USER_ID=
# IG_TOKEN=
